{
  "name": "@nuniapp/cli",
  "version": "0.1.1",
  "description": "Set up Nuni in any project: generates a project ID and prints the install snippet.",
  "license": "MIT",
  "type": "module",
  "homepage": "https://nuni.praveenjuge.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/praveenjuge/nuni.git",
    "directory": "packages/cli"
  },
  "bin": {
    "nuni": "dist/index.mjs"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
