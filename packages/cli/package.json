    "lint": "eslint .",
    "typecheck": "tsc",
    "test": "vitest run"
  },
  "devDependencies": {
    "@nuni/eslint-config": "workspace:*",
    "@nuni/shared": "workspace:*",
    "@nuni/tsconfig": "workspace:*",
    "@types/node": "^22",
    "eslint": "^10.11.0",
    "tsdown": "^0.23.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.2"
  }
}
