    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.1"
