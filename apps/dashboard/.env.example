# WorkOS (https://dashboard.workos.com). Enable GitHub OAuth under Authentication.
WORKOS_CLIENT_ID=client_...
WORKOS_API_KEY=sk_test_...
# 32+ random characters: openssl rand -base64 32
WORKOS_COOKIE_PASSWORD=
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3000/dashboard/callback

# Public origin of the dashboard (the docs site domain in production)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Convex. `convex deploy` injects this on Vercel; locally use the dev deployment URL.
NEXT_PUBLIC_CONVEX_URL=http://127.0.0.1:3210
